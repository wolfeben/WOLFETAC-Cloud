+    /// <summary>Resolve a source vendor to its grower dimension without treating the vendor account as the dimension value.</summary>
+    procedure GrowerCodeForSourceVendor(VendorNo: Code[20]; DimensionSetID: Integer): Code[20]
+    var
+        Vendor: Record Vendor;
+        GrowerCode: Code[20];
+        SourceGrowerCode: Code[20];
+    begin
+        Vendor.Get(VendorNo);
+        GrowerCode := GrowerCodeForVendor(VendorNo);
+        if VendorNoForGrower(GrowerCode) <> VendorNo then
+            Error('Grower dimension %1 does not identify vendor %2.', GrowerCode, VendorNo);
+
+        SourceGrowerCode := DimensionMgt.GetDimensionValue(DimensionSetID, DimensionMgt.GrowerDimensionCode());
+        if (SourceGrowerCode <> '') and (SourceGrowerCode <> GrowerCode) then
+            Error('Source grower dimension %1 does not match vendor %2, whose grower dimension is %3.', SourceGrowerCode, VendorNo, GrowerCode);
+        exit(GrowerCode);
+    end;
